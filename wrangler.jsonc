{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-porto",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Não apaga variáveis cadastradas no painel a cada deploy.
  "keep_vars": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Sem database_id: o wrangler acha o banco pelo nome "no-porto". A publicação (npm run deploy) aplica
  // as migrações antes de subir o código, então numa instalação do zero o banco precisa ser criado antes
  // do primeiro deploy (README).
  "d1_databases": [
    { "binding": "DB", "database_name": "no-porto", "migrations_dir": "migrations" }
  ],
  // Ligação com o No Prelo (19/11/2026): a porta interna "NoPortoApi" do Worker "no-prelo", na mesma
  // conta. Só ela entra: ISBN, PO, gráfica e data de aprovação dos livros. Sem senha nem token.
  "services": [{ "binding": "NOPRELO", "service": "no-prelo", "entrypoint": "NoPortoApi" }],
  // Busca as aprovações do No Prelo uma vez por dia, às 6h40 em Brasília (9h40 UTC).
  "triggers": { "crons": ["40 9 * * *"] }
  // Segredo (painel do Cloudflare → Worker → Configurações → Variáveis e segredos):
  // SETUP_TOKEN, o código pedido na tela de primeiro acesso.
}
