    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
